<cache-config
	xmlns:processing="class:com.oracle.coherence.patterns.processing.config.xml.ProcessingPatternNamespaceHandler"
	xmlns:element="class://com.oracle.coherence.environment.extensible.namespaces.XmlElementProcessingNamespaceContentHandler"
	element:introduce-cache-config="coherence-processingpattern-cache-config.xml
									,coherence-processingpattern-cluster-client-config.xml
									,solvencia-schemes-config.xml
									,cache/solvencia-maestro-cache-config.xml
									,cache/solvencia-conversionesBel-cache-config.xml
									,cache/solvencia-parametrizacionGeneral-cache-config.xml
									,cache/solvencia-conversionesRossp-cache-config.xml
									,cache/solvencia-parametrizacionGeneral-cache-config.xml
									,cache/solvencia-formulacion-cache-config.xml
									,cache/solvencia-salidaCalculo-cache-config.xml">
							
	<processing:cluster-config pof="true" />
			
	<defaults>
		<serializer system-property="tangosol.coherence.serializer">pof</serializer>
		<socket-provider system-property="tangosol.coherence.socketprovider" />
	</defaults>
	
	<caching-schemes>
		<distributed-scheme>
			<scheme-name>distributed-scheme2</scheme-name>
			<service-name>DistributedCache2</service-name>
			<backing-map-scheme>
				<local-scheme />
			</backing-map-scheme>
		</distributed-scheme>
	</caching-schemes>
	
</cache-config>