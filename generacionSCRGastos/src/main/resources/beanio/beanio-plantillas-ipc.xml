<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">
	
	<template name="ipcGeneralFuturoTemplate">
		<field name="finicio" length="8" type="string" justify="left"/>
		<field name="ffin" length="8" type="string" justify="left"/>
		<field name="pipcleg" type="bigdecimal" length="6" padding="0" justify="right" format="+000.##;-000.##" typeHandler="bigDecimalHostHandler" />
		<field name="pipcgas" type="bigdecimal" length="6" padding="0" justify="right" format="+000.##;-000.##" typeHandler="bigDecimalHostHandler" />
	</template>
	
	<template name="salidaIPC">
		<field name="finicio" length="8" justify="left" />
		<field name="ffin" length="8" justify="left" />
		<field name="pipcleg" type="string" length="6" justify="left"  />
		<field name="pipcgas" type="string" length="6" justify="left" />
	</template>
</beanio>