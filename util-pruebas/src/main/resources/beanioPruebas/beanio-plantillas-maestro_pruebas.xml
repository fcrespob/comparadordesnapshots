<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">

	<!-- Plantillas de conjuntos de campos. Cada plantilla representa un bloque 
		dentro de un fichero. -->
	<template name="claveUmic">
		<field name="kmodalidad" length="5" type="int" padding="0" justify="right" format="00000"/>
		<field name="kpoliza" length="10" type="long" padding="0" justify="right" format="0000000000"/>
		<field name="ksubpoliza" length="4" type="int" padding="0" justify="right" format="0000"/>
		<field name="kcertificado" length="6" type="int" padding="0" justify="right" format="000000"/>
		<field name="nsuscri" length="7" type="int" padding="0" justify="right" format="0000000"/>
		<field name="norden" length="3" type="int" padding="0" justify="right" format="000"/>
		<field name="kgarantia" length="5" type="int" padding="0" justify="right" format="00000"/>
		<field name="kprestacion" length="6" type="string" />
		<field name="kajuste" length="7" type="int" padding="0" justify="right" format="0000000"/>
		<field name="ctipoaport" length="1" type="string" />
	</template>

	<template name="datosGenerales">
		<field name="cnegocio" length="1" type="string" justify="left" />
		<field name="ccanal" length="5" type="int" padding="0" justify="right" format="00000"/>
		<field name="ccartera" length="5" type="int" padding="0" justify="right" format="00000"/>
		<!-- facierre, fmcierre, fdcierre -> fecCierre -->
		<!-- <field name="facierre" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmcierre" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdcierre" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecCierre" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />

		<!-- UMIC -->
		<include template="claveUmic"/>
		<field name="filler" length="1" type="string" ignore="true" />
		<!-- FIN UMIC -->

		<field name="tarifa" length="3" type="string" />
		<field name="kcategoria" length="2" type="string" />
		<field name="swinnominada" length="1" type="string" />
		<field name="nasegurados" length="9" type="int" padding="0" justify="right" format="000000000"/>
		<!-- nueva_produc -> Boolean nuevaProduc -->
		<field name="nuevaProduc" length="1" type="boolean" typeHandler="snHandler" />
		<field name="csitupol" length="2" type="string" />
		<field name="ctipramo" length="2" type="string" /> <!-- Cambiado a 2 provisional -->
		<field name="kramo" length="3" type="string" />
		<field name="kmodext" length="5" type="int" padding="0" justify="right" format="00000"/>
		<field name="kcarterainv" length="4" type="string" />
		<field name="koficont" length="5" type="string" />
		<field name="ctipoprovi" length="2" type="string" />
		<field name="swcasado" length="1" type="string" />
		<field name="gapAct" length="4" type="string" />
		<field name="koficina" length="4" type="string" />
		<field name="spcom" length="1" type="string" />
		<field name="reglamento" length="1" type="string" />
		<field name="kbencon" length="3" type="string" />
		<field name="tipoflexseg" length="1" type="string" />
		<field name="tipoflexprim" length="1" type="string" />
		<!-- sig_edifer es el signo de edifer -> se agrupa -->
		<!-- <field name="sig_edifer" length="1" type="string" /> -->
		<field name="edifer" length="4" type="int" padding="0" justify="right"
			format="+0000;-0000" default="+0000" />
		<field name="pb" length="1" type="string" />
		<field name="tipoPb" length="1" type="string" />
		<field name="tipoSubriesgo" length="4" type="string" />
		<field name="indicpension" length="1" type="string" />
		<field name="segmento1" length="4" type="string" />
	</template>

	<template name="datosCoaseguro">
		<field name="kcoaseOri" length="4" type="string" />
		<field name="ctipocoaseg" length="1" type="string" />
		<field name="pcoaseg" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<field name="distint" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<field name="distext" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
	</template>

	<template name="fechas">
		<!-- faefecini, fmefecini, fdefecini -> fecefecini -->
		<!-- <field name="faefecini" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmefecini" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdefecini" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecefecini" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<!-- <field name="faefecred" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmefecred" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdefecred" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecefecred" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<!-- <field name="fainisus" length="4" type="int" padding="0" justify="right" 
			/> <field name="fminisus" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdinisus" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecinisus" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<!-- <field name="faefecfin" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmefecfin" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdefecfin" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecefecfin" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<!-- <field name="fafinfinancia" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmfinfinancia" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdfinfinancia" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecafinfinancia" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<!-- <field name="fainipagprim" length="4" type="int" padding="0" justify="right" 
			/> <field name="fminipagprim" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdinipagprim" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecinipagprim" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<!-- <field name="fafinpagprim" length="4" type="int" padding="0" justify="right" 
			/> <field name="fainipagprim" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdfinpagprim" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecfinpagprim" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<!-- <field name="fadesderenova" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmdesderenova" length="2" type="int" padding="0" justify="right" 
			/> <field name="fddesderenova" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecdesderenova" length="8" format="yyyyMMdd"
			typeHandler="dateRenovacionHandler" />
		<!-- <field name="fahastarenova" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmhastarenova" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdhastarenova" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fechastarenova" length="8" format="yyyyMMdd"
			typeHandler="dateRenovacionHandler" />
		<field name="partano" length="4" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="0000.###" />
		<field name="tc" length="3" type="int" padding="0" justify="right" />
	</template>

	<template name="duraciones">
		<field name="nrenovaciones" length="3" type="int" padding="0" justify="right" format="000"/>
		<field name="ndursegano" length="3" type="int" padding="0" justify="right" format="000"/>
		<field name="ndursegmes" length="3" type="int" padding="0" justify="right" format="000"/>
		<field name="ndursegdia" length="3" type="int" padding="0" justify="right" format="000"/>
		<field name="ndurprima" length="3" type="int" padding="0" justify="right" format="000"/>
	</template>

	<template name="asegurados">
		<field name="porsexh" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<!-- <field name="fanacaseg_1" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmnacaseg_1" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdnacaseg_1" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fnacAseg1" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<field name="csexAseg1" length="1" type="string" />
		<field name="edadAseg1" length="3" type="int" padding="0" justify="right" format="000"/>
		<!-- <field name="fanacaseg_2" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmnacaseg_2" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdnacaseg_2" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fnacAseg2" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<field name="csexAseg2" length="1" type="string" />
		<field name="edadAseg2" length="3" type="int" padding="0" justify="right" format="000"/>
		<!-- <field name="fanacaseg_3" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmnacaseg_3" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdnacaseg_3" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fnacAseg3" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<field name="csexAseg3" length="1" type="string" />
		<field name="edadAseg3" length="3" type="int" padding="0" justify="right" format="000"/>
		<!-- <field name="fanacaseg_4" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmnacaseg_4" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdnacaseg_4" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fnacAseg4" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<field name="csexAseg4" length="1" type="string" />
		<field name="edadAseg4" length="3" type="int" padding="0" justify="right" format="000"/>
		<!-- <field name="fanacaseg_5" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmnacaseg_5" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdnacaseg_5" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fnacAseg5" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<field name="csexAseg5" length="1" type="string" />
		<field name="edadAseg5" length="3" type="int" padding="0" justify="right" format="000"/>
		<field name="gedadMin" length="3" type="int" padding="0" justify="right" format="000"/>
		<field name="gedadMax" length="3" type="int" padding="0" justify="right" format="000"/>
	</template>

	<template name="primas">
		<!-- <field name="sig_primanetaini" length="1" type="string" /> -->
		<field name="iprimanetaini" length="13" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+0000000000.##;-0000000000.##" />
		<!-- <field name="sig_primanetaact" length="1" type="string" /> -->
		<field name="iprimanetaact" length="13" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+0000000000.##;-0000000000.##" />
		<!-- <field name="sig_primatarada" length="1" type="string" /> -->
		<field name="iprimatarada" length="13" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+0000000000.##;-0000000000.##" />
		<field name="cformarevprim" length="1" type="string" />
		<field name="prevprima" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<field name="cformpago" length="1" type="string" />
		<field name="precargfrac" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<field name="fdiadepago" length="2" type="int" padding="0" justify="right" format="00"/>
		<field name="pdtoemp" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<field name="pdtoaseg" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<!-- <field name="sig_pfpinv" length="1" type="string" /> -->
		<field name="pfpinv" length="16" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+0000000000000.##;-0000000000000.##" />
		<!-- <field name="sig_ppcap" length="1" type="string" /> -->
		<field name="ppcap" length="13" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+0000000000.##;-0000000000.##" />
		<!-- <field name="sig_ppc" length="1" type="string" /> -->
		<field name="ppc" length="13" type="bigdecimal" padding="0" justify="right"
			typeHandler="bigDecimalHostHandler" format="+0000000000.##;-0000000000.##" />
		<!-- <field name="sig_ppr" length="1" type="string" /> -->
		<field name="ppr" length="13" type="bigdecimal" padding="0" justify="right"
			typeHandler="bigDecimalHostHandler" format="+0000000000.##;-0000000000.##" />
	</template>

	<template name="capitales">
		<!-- <field name="sig_icapini" length="1" type="string" /> -->
		<field name="icapini" length="13" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+0000000000.##;-0000000000.##" />
		<!-- <field name="sig_capact" length="1" type="string" /> -->
		<field name="icapact" length="13" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+0000000000.##;-0000000000.##" />
		<!-- <field name="sig_saldo" length="1" type="string" /> -->
		<field name="isaldo" length="14" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+00000000000.##;-00000000000.##" />
		<!-- <field name="sig_capfall" length="1" type="string" /> -->
		<field name="icapfall" length="13" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+0000000000.##;-0000000000.##" />
		<field name="cformarevcap" length="1" type="string" />
		<field name="porevalcap" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<field name="porgamma" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<field name="crmax" length="12" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="0000000000.##" />
		<field name="pcapriesgo" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
	</template>

	<template name="rentas">
		<field name="tempVit" length="1" type="string" />
		<!-- <field name="sig_rentini" length="1" type="string" /> -->
		<field name="rentini" length="14" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+00000000000.##;-00000000000.##" />
		<!-- <field name="sig_rentact" length="1" type="string" /> -->
		<field name="rentact" length="14" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+00000000000.##;-00000000000.##" />
		<!-- <field name="sig_rentmini" length="1" type="string" /> -->
		<field name="rentmini" length="14" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="+00000000000.##;-00000000000.##" />
		<!-- <field name="fainiciorta" length="4" type="int" padding="0" justify="right" 
			/> <field name="fminiciorta" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdiniciorta" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecIni" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<!-- <field name="fafinrta" length="4" type="int" padding="0" justify="right" 
			/> <field name="fmfinrta" length="2" type="int" padding="0" justify="right" 
			/> <field name="fdfinrta" length="2" type="int" padding="0" justify="right" 
			/> -->
		<field name="fecFin" length="8" format="yyyyMMdd"
			typeHandler="dateNullHandler" />
		<field name="prevrenta" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<field name="preversion" length="5" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.##" />
		<field name="npergaran" length="3" type="int" padding="0"
			justify="right" />
		<field name="nadifer" length="3" type="int" padding="0" justify="right" />
		<field name="forpagrent" length="2" type="int" padding="0"
			justify="right" />
		<field name="cpagrenta" length="1" type="string" />
		<field name="ctipoRevrenta" length="1" type="string" />
		<field name="cformaRevrenta" length="1" type="string" />
		<field name="ndurrenta" length="2" type="int" padding="0"
			justify="right" />
	</template>

	<template name="rescates">
		<field name="codTir" length="2" type="string" />
		<field name="tirIni" length="9" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.######" />
		<field name="tirCie" length="9" type="bigdecimal" padding="0"
			justify="right" typeHandler="bigDecimalHostHandler" format="000.######" />
		<field name="krescate1" length="5" type="string" />
		<field name="krescate2" length="5" type="string" />
		<field name="krescate3" length="5" type="string" />
		<field name="indicrescate" length="1" type="string" />
		<field name="riesgrescI" length="1" type="string" />
	</template>

