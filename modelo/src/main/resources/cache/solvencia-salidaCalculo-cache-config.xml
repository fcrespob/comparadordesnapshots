<?xml version="1.0"?>

<cache-config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.oracle.com/coherence/coherence-cache-config"
	xmlns:element="class://com.oracle.coherence.common.namespace.preprocessing.XmlPreprocessingNamespaceHandler"
	xsi:schemaLocation="http://xmlns.oracle.com/coherence/coherence-cache-config coherence-cache-config.xsd"
	element:introduce-cache-config="solvencia-schemes-config.xml">

	<caching-scheme-mapping>

		<cache-mapping>
			<cache-name>detalle-corriente</cache-name>
			<scheme-name>distributed-associated-scheme</scheme-name>
			<init-params>
				<init-param>
					<param-name>back-size-limit</param-name>
					<param-value>160MB</param-value>
				</init-param>
			</init-params>
		</cache-mapping>
		
		<cache-mapping>
			<cache-name>totales-flujos</cache-name>
			<scheme-name>distributed-associated-scheme</scheme-name>
			<init-params>
				<init-param>
					<param-name>back-size-limit</param-name>
					<param-value>657MB</param-value>
				</init-param>
			</init-params>
		</cache-mapping>
			
		<cache-mapping>
			<cache-name>incidencias</cache-name>
			<scheme-name>distributed-associated-scheme</scheme-name>
			<init-params>
				<init-param>
					<param-name>back-size-limit</param-name>
					<param-value>256MB</param-value>
				</init-param>
			</init-params>
		</cache-mapping>

		<cache-mapping>
			<cache-name>detalle-basetecnicas</cache-name>
			<scheme-name>distributed-associated-scheme</scheme-name>
			<init-params>
				<init-param>
					<param-name>back-size-limit</param-name>
					<param-value>423MB</param-value>
				</init-param>
			</init-params>
		</cache-mapping>
		
		<!-- fichas-resultados -->
		<cache-mapping>
			<cache-name>R340T003</cache-name>
			<scheme-name>distributed-associated-scheme</scheme-name>
			<init-params>
				<init-param>
					<param-name>back-size-limit</param-name>
					<param-value>1MB</param-value>
				</init-param>
			</init-params>
		</cache-mapping>	
		
		<!-- cache de resultados intermedios -->
		<cache-mapping>
			<cache-name>datos-calculados-umic</cache-name>
			<scheme-name>local-scheme</scheme-name>
		</cache-mapping>	
		
		<!-- cache de incidencias producidas en la carga del maestro -->
		<cache-mapping>
			<cache-name>incidenciasmaestro</cache-name>
			<scheme-name>distributed-associated-scheme</scheme-name>
			<init-params>
				<init-param>
					<param-name>back-size-limit</param-name>
					<param-value>256MB</param-value>
				</init-param>
			</init-params>
		</cache-mapping>
			
	</caching-scheme-mapping>

	<caching-schemes>
		<local-scheme>
			<scheme-name>local-scheme</scheme-name>
		</local-scheme>
	</caching-schemes>
</cache-config>