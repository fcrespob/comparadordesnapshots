<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">

	<!-- Plantillas de conjuntos de campos. Cada plantilla representa un bloque 
		dentro de un fichero. -->
	
	<template name="gastosReales">
		<field name="ktipobt" type="string" length="8" justify="left" />
		<field name="ccanal" type="int" length="5" padding="0" justify="right" format="00000" />
		<field name="cnegocio" length="1" type="string" justify="left" />
		<field name="kramo" type="string" length="3" justify="left" />
		<field name="kmodalidad" type="int" length="5" padding="0" justify="right" format="00000" />
		<field name="fecDesde" length="8" format="yyyyMMdd" typeHandler="dateNullHandler" />
		<field name="fecHasta" length="8" format="yyyyMMdd" typeHandler="dateNullHandler" />
		<field name="gastoPorUmic" type="bigdecimal" length="7" padding="0" justify="right" format="00000.##" typeHandler="bigDecimalHostHandler" />
		<field name="pctGastoProv" type="bigdecimal" length="7" padding="0" justify="right" format="00.#####" typeHandler="bigDecimalHostHandler" />
		<field name="matching" type="string" length="1" justify="left" />
	</template>
	
	<template name="valoresCurvaTipos">
		<field name="codCurvaTipos" type="string" length="7" justify="left" />
		<field name="fecEfecCurva" length="8" format="yyyyMMdd" typeHandler="dateNullHandler" />
		<field name="diasPlazo" type="int" length="5" padding="0" justify="right" format="00000" />
		<field name="porcentajeInteres" type="bigdecimal" length="11" padding="0" justify="right" format="+00.########;-00.########" typeHandler="bigDecimalHostHandler" />
	</template>
	
	<template name="valoresAnulacionMensuales">
		<field name="codTabla" type="string" length="7" justify="left" />
		<field name="fecCierre" length="8" format="yyyyMMdd" typeHandler="dateNullHandler" />
		<field name="mesesDesde" type="int" length="4" padding="0" justify="right" format="0000" />
		<field name="probabAnul" type="bigdecimal" length="11" padding="0" justify="right" format="0.##########" typeHandler="bigDecimalHostHandler" />
		<field name="polizaVigentes" type="bigdecimal" length="9" padding="0" justify="right" format="0000000.##" typeHandler="bigDecimalHostHandler" />
	</template>
	
	<template name="valoresAnulacion">
		<field name="codTabla" type="string" length="7" justify="left" />
		<field name="fecCierre" length="8" format="yyyyMMdd" typeHandler="dateNullHandler" />
		<field name="aniosDesde" type="bigdecimal" length="7" padding="0" justify="right" format="000.####" typeHandler="bigDecimalHostHandler" />
		<field name="probabAnul" type="bigdecimal" length="11" padding="0" justify="right" format="0.##########" typeHandler="bigDecimalHostHandler" />
		<field name="polizaVigentes" type="bigdecimal" length="9" padding="0" justify="right" format="0000000.##" typeHandler="bigDecimalHostHandler" />
	</template>
	
	<template name="tablasExperienciaReales">
		<field name="fecCierre" length="8" format="yyyyMMdd" typeHandler="dateNullHandler" />
		<field name="kbasetec" type="string" length="8" justify="left" />
		<field name="compania" length="5"  type="int" padding="0" justify="right" format="00000" />
		<field name="cnegocio" length="1" type="string" justify="left" />
		<field name="riesgoActuarial" type="string" length="4" justify="left" />
		<field name="sexo" type="string" length="1" justify="left" />
		<field name="categoria" type="string" length="2" justify="left" />
		<field name="edadFija" type="int" length="3" padding="0" justify="right" format="000" />
		<!-- <field name="edadDesde" type="int" length="3" padding="0" justify="right" format="000" />
		<field name="edadHasta" type="int" length="3" padding="0" justify="right" format="000" /> -->
		<field name="kmodalidad" type="int" length="5" padding="0" justify="right" format="00000" />
		<field name="tablaBase" length="5" type="int" padding="0" justify="right" format="00000" />
		<field name="generacion" length="4" type="int" padding="0" justify="right" format="0000" />
		<!-- <field name="anoPoliza" type="int" length="3" padding="0" justify="right" format="000" />
		<field name="sobrerriesgo" type="bigdecimal" length="5" padding="0" justify="right" format="000.##" typeHandler="bigDecimalHostHandler" />
		<field name="sobremortalidad" type="bigdecimal" length="5" padding="0" justify="right" format="000.##" typeHandler="bigDecimalHostHandler" /> -->
		<field name="q" type="bigdecimal" length="17" collection="list" padding="0" justify="right" format="000000000.########" typeHandler="bigDecimalHostHandler" minOccurs="130"/>
 		<field name="l" type="bigdecimal" length="17" collection="list" padding="0" justify="right" format="000000000.########" typeHandler="bigDecimalHostHandler" minOccurs="130"/>
	</template>
	
	<template name="valoresEstres">
		<field name="feccierre" format="yyyyMMdd" typeHandler="dateNullHandler" length="8"/>
		<field name="bt" length="8" type="string" justify="left"/>
		<field name="variable" type="string" length="10" justify="left" />
		<field name="valor" type="bigdecimal" length="8" padding="0" justify="right" format="+000.####;-000.####" typeHandler="bigDecimalHostHandler" />
	</template>
	
</beanio>