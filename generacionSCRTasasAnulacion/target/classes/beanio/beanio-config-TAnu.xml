<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">

	<!-- Imports de las plantillas a emplear en los streams de este fichero -->
	<import resource="classpath:beanio/beanio-plantillas-tasasAnu.xml" />
	
	<typeHandler name="dateNullHandler"
		class="es.mapfre.scr.tasasAnulacion.utils.beanio.handlers.DateNullTypeHandler" >
		<property name="nullDate" value="00000000" />
		<property name="lastDate" value="99999999" />	
		<property name="lastValiedDate" value="99991231"/>
	</typeHandler>	
	
	<typeHandler name="timeoNullHandler"
		class="es.mapfre.scr.tasasAnulacion.utils.beanio.handlers.TimeNullTypeHandler" >
		<property name="lastValiedDate" value="99991231" />
		<property name="lastValiedTime" value="235959" />
		<property name="datePosition" value="0" />
		<property name="timeposition" value="8" />
		<property name="nullTime" value="000000" />
		<property name="lastTime" value="999999" />
		<property name="nullDate" value="00000000" />
		<property name="lastDate" value="99999999" />
	</typeHandler>
	
	<typeHandler name="bigDecimalHostHandler"
		class="es.mapfre.scr.tasasAnulacion.utils.beanio.handlers.BigDecimalHostInTypeHandler" />
		
	<typeHandler name="stringOutHandler"
		class="es.mapfre.scr.tasasAnulacion.utils.beanio.handlers.StringTypeHandler" />
	
	<!-- tasasAnul -->
	<stream name="VTA0" format="fixedlength">
		<record name="valoresTasasAnul" template="valoresTasasAnul"
			class="es.mapfre.scr.tasasAnulacion.dominio.entidades.TasasAnulacion" />
	</stream>
	
	<!--  incidencias -->
	<stream name="INC0" format="delimited">
		<record name="incidencias" template="incidencias"
			class="es.mapfre.scr.tasasAnulacion.dominio.entidades.Incidencias" />
	</stream>
	
	<!--  salida -->
	<stream name="SAL0" format="fixedlength">
		<record name="tasasAnualizadas" template="tasasAnualizadas"
			class="es.mapfre.scr.tasasAnulacion.dominio.entidades.Salida" />
	</stream>

	<!-- estres -->
	<stream name="SCR0" format="fixedlength">
		<record name="valoresEstres" template="valoresEstres"
			class="es.mapfre.scr.tasasAnulacion.dominio.entidades.ValoresEstres" />
	</stream>
	
	<stream name="R340T000" format="fixedlength">
		<group name="fichaProceso" class="es.mapfre.scr.tasasAnulacion.dominio.entidades.FichaProceso" minOccurs="0" maxOccurs="unbounded">
			<record name="cabecera" template="fichaProcesoR340T001" minOccurs="1" maxOccurs="1" />					 		
			<record name="filtrosAmbito" collection="list" minOccurs="0" maxOccurs="unbounded" 
				class="es.mapfre.scr.tasasAnulacion.dominio.entidades.FiltroFichaProceso" template="filtroProcesoT2"/>
			<record name="filtrosAdicionales" collection="list" minOccurs="0" maxOccurs="unbounded"
					class="es.mapfre.scr.tasasAnulacion.dominio.entidades.FiltroFichaProcesoAdicional" template="filtroProcesoT3"/>
			<record name="registroParametros" template="registroT4" minOccurs="0" maxOccurs="1"	class="es.mapfre.scr.tasasAnulacion.dominio.entidades.RegistroParametros"/>
		</group>	
	</stream>
	
	<stream name="R340T003" format="fixedlength">
		<record name="fichaProcesoR340T003" template="fichaProcesoR340T003"	
		class="es.mapfre.scr.tasasAnulacion.dominio.entidades.FichaResultado"/>
	</stream>
	
</beanio>