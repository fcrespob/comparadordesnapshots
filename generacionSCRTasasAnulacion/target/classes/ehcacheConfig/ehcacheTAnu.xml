<?xml version="1.0" encoding="UTF-8"?>
<ehcache xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="ehcacheTAnu.xsd"
         updateCheck="true" monitoring="autodetect"
         dynamicConfig="true">


    <diskStore path="java.io.tmpdir"/>

    <defaultCache
            maxEntriesLocalHeap="100000"
            eternal="false"
            timeToIdleSeconds="120"
            timeToLiveSeconds="120"
            diskSpoolBufferSizeMB="30"
            maxEntriesLocalDisk="10000000"
            diskExpiryThreadIntervalSeconds="120"
            memoryStoreEvictionPolicy="LRU"
            statistics="false">
        <persistence strategy="localTempSwap"/>
    </defaultCache>

	<cache name="R340T000"
           maxEntriesLocalHeap="10000"
           eternal="true"
           memoryStoreEvictionPolicy="LFU"
           transactionalMode="off">
        <persistence strategy="none"/>
    </cache>

    <cache name="VTA0"
           maxEntriesLocalHeap="10000"
           eternal="true"
           memoryStoreEvictionPolicy="LFU"
           transactionalMode="off">
        <searchable>
           <searchAttribute name="kfcierre" expression="value.getKfcierre()"/>
           <searchAttribute name="ktablaanu" expression="value.getKtablaanu()"/>
           <searchAttribute name="kaniosdesde" expression="value.getKaniosdesde()"/>
        </searchable>
        <persistence strategy="none"/>
    </cache>
    
    <cache name="SCR0"
           maxEntriesLocalHeap="10000"
           eternal="true"
           memoryStoreEvictionPolicy="LFU"
           transactionalMode="off">
        <searchable>
           <searchAttribute name="feccierre" expression="value.getFeccierre()"/>
           <searchAttribute name="bt" expression="value.getBt()"/>
        </searchable>
        <persistence strategy="none"/>
    </cache>
    
</ehcache>