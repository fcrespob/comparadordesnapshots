<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">
	
	<template name="log">
		<field name="ksistema" type="string" length="10" justify="left" />
		<field name="kfecha" type="string" length="20" justify="left" />
		<field name="ktipoinfo" type="string" length="8" justify="left" />
		<field name="gc1Resul" type="string" length="500" justify="left" />
		<field name="gc2Resul" type="string" length="20" justify="left" />
		<field name="gc3Resul" type="string" length="20" justify="left" />
		<field name="gc4Resul" type="string" length="20" justify="left" />
		<field name="gc5Resul" type="string" length="20" justify="left" />
		<field name="gc6Resul" type="string" length="20" justify="left" />
		<field name="gc7Resul" type="string" length="20" justify="left" />
		<field name="gc8Resul" type="string" length="20" justify="left" />
		<field name="gc9Resul" type="string" length="20" justify="left" />
		<field name="gc10Resul" type="string" length="20" justify="left" />
		<field name="filler" type="string" length="88" justify="left" padding=" " ignore="true" />
	</template>
	
	<template name="incidencias">
		<field name="feccierre" type="string" length="8" justify="left" />
		<field name="canal" type="string" length="2" justify="left" />
		<field name="codigoerror" type="string" length="2" justify="left" />
		<field name="descerror" type="string" length="400" justify="left" />
	</template>
</beanio>