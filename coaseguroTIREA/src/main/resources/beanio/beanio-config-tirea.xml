<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">

	<!-- Imports de las plantillas a emplear en los streams de este fichero -->
	<import resource="classpath:beanio/beanio-plantillas-entrada.xml" />
	<import resource="classpath:beanio/beanio-plantillas-salida.xml" />
	
	<typeHandler name="dateNullHandler"
		class="es.mapfre.coaseguro.tirea.utils.beanio.handlers.DateNullTypeHandler" >
		<property name="nullDate" value="00000000" />
		<property name="lastDate" value="99999999" />	
		<property name="lastValiedDate" value="99991231"/>
	</typeHandler>
	
	<typeHandler name="timeoNullHandler"
		class="es.mapfre.coaseguro.tirea.utils.beanio.handlers.TimeNullTypeHandler" >
		<property name="lastValiedDate" value="99991231" />
		<property name="lastValiedTime" value="235959" />
		<property name="datePosition" value="0" />
		<property name="timeposition" value="8" />
		<property name="nullTime" value="000000" />
		<property name="lastTime" value="999999" />
		<property name="nullDate" value="00000000" />
		<property name="lastDate" value="99999999" />
	</typeHandler>
	
	<typeHandler name="bigDecimalHostHandler"
		class="es.mapfre.coaseguro.tirea.utils.beanio.handlers.BigDecimalHostInTypeHandler" />
		
	<typeHandler name="stringOutHandler"
		class="es.mapfre.coaseguro.tirea.utils.beanio.handlers.StringTypeHandler" />
		
	<!--  incidencias -->
	<stream name="INC0" format="fixedlength">
		<record name="incidencias" template="incidencias"
			class="es.mapfre.coaseguro.tirea.dominio.entidades.Incidencias" />
	</stream>
	<!-- ficha de proceso -->
	<stream name="FIC0" format="fixedlength">
		<record name="fichaproceso" template="fichaproceso"
			class="es.mapfre.coaseguro.tirea.dominio.entidades.FichaProceso" />
	</stream>
	
	<stream name="FLUJPMACOA" format="fixedlength">
		<record name="flujpmacoa" template="flujpmacoa"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.FlujPMaCoa"/>
	</stream>
	
	<stream name="FLUJPMACOABTCOA" format="fixedlength">
		<record name="flujpmacoabtcoa" template="flujpmacoabtcoa"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.FlujPmaCoaBtcoa"/>
	</stream>
	
	<stream name="FLUJPMACOABTCOATF" format="fixedlength">
		<record name="flujpmacoabtcoatf" template="flujpmacoabtcoatf"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.FlujPmaCoaBtcoatf"/>
	</stream>
	
	<stream name="TOTPMACOA" format="fixedlength">
		<record name="totpmacoa" template="totpmacoa"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.TotPMaCoa"/>
	</stream>
	
	<stream name="TOTPMACOABTCOA" format="fixedlength">
		<record name="totpmacoabtcoa" template="totpmacoabtcoa"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.TotPmaCoaBtcoa"/>
	</stream>
	
	<stream name="TOTPMACOABTCOATF" format="fixedlength">
		<record name="totpmacoabtcoatf" template="totpmacoabtcoatf"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.TotPmaCoaBtcoatf"/>
	</stream>
	
	<stream name="FLUJPMDCOA" format="fixedlength">
		<record name="flujpmdcoa" template="flujpmdcoa"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.FlujPMdCoa"/>
	</stream>
	
	<stream name="FLUJPMDCOABTCOA" format="fixedlength">
		<record name="flujpmdcoabtcoa" template="flujpmdcoabtcoa"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.FlujPmdCoaBtcoa"/>
	</stream>
	
	<stream name="FLUJPMDCOABTCOATF" format="fixedlength">
		<record name="flujpmdcoabtcoatf" template="flujpmdcoabtcoatf"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.FlujPmdCoaBtcoatf"/>
	</stream>
	
	<stream name="DATOSCOA" format="fixedlength">
		<record name="datosCoa" template="datosCoa"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.DatosCoa"/>
	</stream>
	
	<stream name="TAB35012" format="fixedlength">
		<record name="tablaMapfre" template="tablaMapfre"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.Tab35012"/>
	</stream>
	
	<stream name="LOG0" format="fixedlength">
		<record name="log" template="log"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.FichaResultado"/>
	</stream>
	
	<stream name="TAB35013" format="fixedlength">
		<record name="tablaMapfreTirea" template="tablaMapfreTirea"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.Tab35013"/>
	</stream>
	
	<stream name="TAB35014" format="fixedlength">
		<record name="tablaPrestacionTirea" template="tablaPrestacionTirea"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.Tab35014"/>
	</stream>
	
	<stream name="TAB35015" format="fixedlength">
		<record name="tablaGarantiaTirea" template="tablaGarantiaTirea"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.Tab35015"/>
	</stream>
	
	<stream name="DATOSESPECIFIC" format="fixedlength">
		<record name="datosEspecific" template="datosEspecific"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.DatosEspecific"/>
	</stream>
	
	<stream name="PAGOSPLAN" format="fixedlength">
		<record name="pagosPlan" template="pagosPlan"	
		class="es.mapfre.coaseguro.tirea.dominio.entidades.PagosPlan"/>
	</stream>
	
</beanio>