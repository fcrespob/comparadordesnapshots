<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">

	<!-- Imports de las plantillas a emplear en los streams de este fichero -->
	<import resource="classpath:beanio/beanio-plantillas-mensualizador.xml" />
	
	<typeHandler name="dateNullHandler"
		class="es.mapfre.gbt.mensualizadorTasas.handlers.DateNullTypeHandler" >
		<property name="nullDate" value="00000000" />
		<property name="lastDate" value="99999999" />	
		<property name="lastValiedDate" value="99991231"/>
	</typeHandler>	
	
	<typeHandler name="timeoNullHandler"
		class="es.mapfre.gbt.mensualizadorTasas.handlers.TimeNullTypeHandler" >
		<property name="lastValiedDate" value="99991231" />
		<property name="lastValiedTime" value="235959" />
		<property name="datePosition" value="0" />
		<property name="timeposition" value="8" />
		<property name="nullTime" value="000000" />
		<property name="lastTime" value="999999" />
		<property name="nullDate" value="00000000" />
		<property name="lastDate" value="99999999" />
	</typeHandler>
	
	<typeHandler name="bigDecimalHostHandler"
		class="es.mapfre.gbt.mensualizadorTasas.handlers.BigDecimalHostInTypeHandler" />
	
	<!-- tasasAnul -->
	<stream name="VTA0" format="fixedlength">
		<record name="valoresTasasAnul" template="valoresTasasAnul"
			class="es.mapfre.gbt.mensualizadorTasas.dominio.TasasAnulacion" />
	</stream>
	
	<!-- Fichas Proceso -->
	<stream name="R340T000" format="fixedlength">
		<group name="fichaProceso" class="es.mapfre.gbt.mensualizadorTasas.dominio.FichaProceso" minOccurs="0" maxOccurs="unbounded">
		
			<record name="cabecera" template="fichaProcesoR340T001" minOccurs="1" maxOccurs="1" />	
				 		
			<record name="filtrosAmbito" collection="list" minOccurs="0" maxOccurs="unbounded" 
				class="es.mapfre.gbt.mensualizadorTasas.dominio.FiltroFichaProceso" template="filtroProcesoT2"/>

			<!-- NUEVO -->
<!--			<record name="filtrosAdicionales" collection="list" minOccurs="0" maxOccurs="unbounded"-->
<!--					class="es.mapfre.gbt.mensualizadorTasas.dominio.FiltroFichaProcesoAdicional" template="filtroProcesoT3"/>-->
			<!-- FIN NUEVO -->
			
			<!-- TODO: Obligar a que siempre esté presente este registro -->
			
			<record name="registroParametros" template="registroT4" minOccurs="0" maxOccurs="1"	class="es.mapfre.gbt.mensualizadorTasas.dominio.RegistroParametros"/>
			
			<!-- <group name="parametrosAdicionales" collection="list" class="es.mapfre.gbt.mensualizadorTasas.es.mapfre.solvencia.dominio.parametrizacionGeneral.fichaProceso.ParametroAdicional" template="fichaProcesoR340T004"/> -->
	
		</group>	
	</stream>
</beanio>