<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">

	<template name="tasasMensualizadas">
		<field name="ktablaanu" 	type="string" length="7" justify="left" />
		<field name="kfcierre" 	type="string" length="8" justify="left" />
		<field name="kaniosdesde" type="bigdecimal" length="7" padding="0" justify="right" format="000.0000" typeHandler="bigDecimalOutHandler"/>
		<field name="tasaRed"    type="bigDecimal" length="11"  justify="right" typeHandler="bigDecimalOutHandler" format="0.0000000000"/>
		<field name="poliza"      type="bigDecimal" length="10"  justify="right" typeHandler="bigDecimalOutHandler" format="0000000.000"/>
		<field name="usuarioAlta" type="string" length="8" justify="left" />
		<field name="fechaAlta" type="string" length="8" justify="left" />
	</template>
	
	<template name="incidencias">
		<field name="tabla" type="string" length="7" justify="left" />
		<field name="fecha" type="string" length="8" justify="left" />
		<field name="descripcion" type="string" length="256" justify="left" />
	</template>
	
	<template name="fichaProcesoR340T003">
		<!-- Check -->
		<!-- <field name="recordType"  type="string" length="2" /> -->
		<field name="kejecucion" type="int" length="10" padding="0" justify="right" format="0000000000" />
		<field name="ksistema" type="string" length="4" justify="left" />
		<field name="kprotecnico" type="string" length="4" justify="left" />
		<field name="kuejecucion" type="string" length="4" justify="left" />
		<field name="ksecuencia" type="int" length="3" padding="0" justify="right" format="000" />
		<field name="ktipores" type="string" length="4" justify="left" />
		<field name="ksecres" type="int" length="3" padding="0" justify="right" format="000" />
		<field name="gc1Resul" type="string" length="200" justify="left" />
		<field name="gc2Resul" type="string" length="20" justify="left" />
		<field name="gc3Resul" type="string" length="20" justify="left" />
		<field name="gc4Resul" type="string" length="20" justify="left" />
		<field name="gc5Resul" type="string" length="20" justify="left" />
		<field name="gc6Resul" type="string" length="20" justify="left" />
		<field name="gc7Resul" type="string" length="20" justify="left" />
		<field name="gc8Resul" type="string" length="20" justify="left" />
		<field name="gc9Resul" type="string" length="20" justify="left" />
		<field name="gc10Resul" type="string" length="20" justify="left" />
		<field name="filler" type="string" length="88" justify="left" padding=" " ignore="true" />
	</template>
	
</beanio>