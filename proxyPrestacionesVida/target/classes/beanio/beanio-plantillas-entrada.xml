<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">
	
	<template name="fichaproceso">
		<field name="ccanal" type="int" length="2" padding="0" justify="right" format="00" />
		<field name="fecCierre" length="8" format="yyyyMMdd" typeHandler="dateNullHandler" />
		<field name="fecPesos" length="8" format="yyyyMMdd" typeHandler="dateNullHandler" />
		<field name="sistema" type="string" length="10" justify="left" />
	</template>
	
	<template name="flujosReales">
		<field name="codCia" type="int" length="2" padding="0" justify="right" format="00" />
		<field name="numExp" length="20" type="string" justify="left"/>
		<field name="anioMes" type="int" length="6" padding="0" justify="right" format="000000" />
		<field name="numMvto" type="int" length="4" padding="0" justify="right" format="0000" />
		<field name="fillerMvto" type="int" length="2" padding="0" justify="right" format="00" />
		<field name="codCob" type="int" length="8" padding="0" justify="right" format="00000000" />
		<field name="codCtoRva" type="long" length="10" padding="0" justify="right" format="0000000000" />
		<field name="codProductor" length="2" type="string" justify="left"/>
		<field name="claseProductor" length="2" type="string" justify="left"/>
		<field name="claseMediador" length="2" type="string" justify="left"/>
		<field name="tipDocum" length="3" type="string" justify="left"/>
		<field name="codDocum" length="20" type="string" justify="left"/>
		<field name="ofDirecta" length="4" type="string" justify="left"/>
		<field name="codTerceroAgt" length="10" type="string" justify="left"/>
		<field name="fecMovExp" length="8" format="yyyyMMdd" typeHandler="dateNullHandler"/>
		<field name="tipExp" length="5" type="string" justify="left"/>
		<field name="codTipcGrpTipExp" length="3" type="string" justify="left"/>
		<field name="fecOcurSini" length="8" format="yyyyMMdd" typeHandler="dateNullHandler"/>
		<field name="fecApertExp" length="8" format="yyyyMMdd" typeHandler="dateNullHandler"/>
		<field name="fecReapertExp" length="8" format="yyyyMMdd" typeHandler="dateNullHandler"/>
		<field name="fecTermExp" length="8" format="yyyyMMdd" typeHandler="dateNullHandler"/>
		<field name="codMon" length="3" type="string" justify="left"/>
		<field name="claseExp" length="1" type="string" justify="left"/>
		<field name="numPoliza" length="25" type="string" justify="left"/>
		<field name="numApli" type="int" length="5" padding="0" justify="right" format="000000" />
		<field name="numRiesgo" type="int" length="6" padding="0" justify="right" format="000000" />
		<field name="modalidad" type="int" length="6" padding="0" justify="right" format="000000" />
		<field name="codRamo" length="4" type="string" justify="left"/>
		<field name="codSector" type="int" length="4" padding="0" justify="right" format="000000" />
		<field name="tipCoa" length="1" type="string" justify="left"/>
		<field name="tipRea" length="1" type="string" justify="left"/>
		<field name="pctCoa" length="5" type="string" justify="left"/>
		<field name="tipoMov" length="1" type="string" justify="left"/>
		<field name="tipoOper" length="1" type="string" justify="left"/>
		<field name="valTotalReservaMes" type="bigdecimal" length="15" padding="0" justify="right" format="+000000000000.##;-000000000000.##" typeHandler="bigDecimalHostHandler" />
		<field name="pagoAnual" type="bigdecimal" length="15" padding="0" justify="right" format="+000000000000.##;-000000000000.##" typeHandler="bigDecimalHostHandler" />
		<field name="importeValoracion" type="bigdecimal" length="15" padding="0" justify="right" format="+000000000000.##;-000000000000.##" typeHandler="bigDecimalHostHandler" />
		<field name="importePago" type="bigdecimal" length="15" padding="0" justify="right" format="+000000000000.##;-000000000000.##" typeHandler="bigDecimalHostHandler" />
		<field name="fecMovEco" length="8" format="yyyyMMdd" typeHandler="dateNullHandler"/>
		<field name="codMonPago" length="3" type="string" justify="left"/>
		<field name="cohorte" length="4" type="int" padding="0" justify="right" format="0000"/>
		<field name="fecEfectoIni" length="8" format="yyyyMMdd" typeHandler="dateNullHandler"/>
		<field name="fecEfectoSpto" length="8" format="yyyyMMdd" typeHandler="dateNullHandler"/>
		<field name="fecSuscripcion" length="8" format="yyyyMMdd" typeHandler="dateNullHandler"/>
		<field name="codLobBis" length="15" type="string" justify="left"/>
		<field name="pctDesglose" length="9" type="string" justify="left"/>
		<field name="sistema" length="20" type="string" justify="left"/>
		<field name="claveIncCorr" type="int" length="12" padding="0" justify="right" format="000000000000" />
		<field name="fechaEstado" length="8" format="yyyyMMdd" typeHandler="dateNullHandler"/>
		<field name="mcaVigente" length="1" type="string" justify="left"/>
	</template>
	
	<template name="pesosBt">
		<field name="cnegocio" length="1" type="string" justify="left" />
		<field name="ccanal" length="5" type="int" padding="0" justify="right" format="00000"/>
		<field name="ccartera" length="5" type="int" padding="0" justify="right" format="00000"/>
		<field name="fcierre" length="8" format="yyyyMMdd" typeHandler="dateNullHandler" />	
		<field name="kmodalidad" length="5" type="int" padding="0" justify="right" format="00000"/>	
		<field name="kpoliza" type="long" length="10" padding="0" justify="right" format="0000000000" />
		<field name="ksubpoliza" type="int" length="4" padding="0" justify="right" format="0000" />
		<field name="kcertificado" type="int" length="6" padding="0" justify="right" format="000000" />
		<field name="cohorte" required="false" length="4" type="string" />
		<field name="swcasado" length="1" type="string" />
		<field name="totFactActT" type="bigdecimal" typeHandler="bigDecimalHostHandler" length="16" padding="0" justify="right" 
			format="+0000000000000.##;-0000000000000.##" />
		<field name="pesosUoA" type="bigdecimal" typeHandler="bigDecimalHostHandler" length="8" padding="0" justify="right" 
			format="+00000.##;-00000.##" />
	</template>
</beanio>