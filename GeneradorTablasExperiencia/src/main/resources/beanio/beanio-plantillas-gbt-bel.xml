<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">

	<!-- Plantillas de conjuntos de campos. Cada plantilla representa un bloque 
		dentro de un fichero. -->
	<!-- Tabla Criterios Conversión Tablas de Experiencia Reales TB340ATR0 -->
	<template name="convTablasExperienciaReales">
		<field name="kbasetec" type="string" length="8" justify="left" />
		<field name="kcompania" type="int" length="5" justify="left" />
		<field name="knegocio" length="1" type="string" justify="left" />
		<field name="kriesgo" type="string" length="4" justify="left" />
		<field name="ksexo" type="string" length="1" justify="left" />
		<field name="kcateg" type="string" length="2" justify="left" />
		<field name="kedaddesde" type="int" length="3" padding="0" justify="right" format="000" />
		<field name="kmodalidad" type="int" length="5" padding="0" justify="right" format="00000" />
		<field name="kfdesde" type="string" length="8" justify="left" />
		<field name="edadhasta" type="int" length="3" padding="0" justify="right" format="000" />
		<field name="fhasta" type="string" length="8" justify="left" />
		<field name="ctabbase" type="int" length="5" padding="0" justify="right" format="00000" />
		<field name="pfactor1" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="pfactor2a" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="pfactor2b" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="pfactor2c" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="pfactor2d" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="pfactor2e" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="pfactor2f" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="pfactor2g" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="pfactor2h" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="pfactor2i" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="pfactor2j" type="bigDecimal" length="6"  justify="right" typeHandler="bigDecimalHostHandler" format="000.000"/>
 		<field name="cusuaralta" type="string" length="8" justify="left" />
		<field name="falta" type="string" length="8" justify="left" />
		<field name="cusuarmodif" type="string" length="8" justify="left" />
		<field name="fmodif" length="8" format="yyyyMMdd" typeHandler="dateNullHandler" />
 	</template>
	
</beanio>