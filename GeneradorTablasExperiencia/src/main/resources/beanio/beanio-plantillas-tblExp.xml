<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">

	<!-- Imports de las plantillas a emplear en los streams de este fichero -->
	<import resource="classpath:beanio/beanio-plantillas-gbt-bel.xml" />
	<import resource="classpath:beanio/beanio-plantillas-gbt-rossp.xml" />
	<import resource="classpath:beanio/beanio-plantillas-GBT.xml" />
	
	<typeHandler name="dateNullHandler"
		class="es.mapfre.gbt.tablasExperiencia.utils.beanio.handlers.DateNullTypeHandler" >
		<property name="nullDate" value="00000000" />
		<property name="lastDate" value="99999999" />	
		<property name="lastValiedDate" value="99991231"/>
	</typeHandler>	
	
	<typeHandler name="timeoNullHandler"
		class="es.mapfre.gbt.tablasExperiencia.utils.beanio.handlers.TimeNullTypeHandler" >
		<property name="lastValiedDate" value="99991231" />
		<property name="lastValiedTime" value="235959" />
		<property name="datePosition" value="0" />
		<property name="timeposition" value="8" />
		<property name="nullTime" value="000000" />
		<property name="lastTime" value="999999" />
		<property name="nullDate" value="00000000" />
		<property name="lastDate" value="99999999" />
	</typeHandler>
	
	<typeHandler name="bigDecimalHostHandler"
		class="es.mapfre.gbt.tablasExperiencia.utils.beanio.handlers.BigDecimalHostInTypeHandler" />
		
	<typeHandler name="stringOutHandler"
		class="es.mapfre.gbt.tablasExperiencia.utils.beanio.handlers.StringTypeHandler" />
	
	<!-- convTablasExp -->
	<stream name="ATR0" format="fixedlength">
		<record name="convTablasExperienciaReales" template="convTablasExperienciaReales"
			class="es.mapfre.gbt.tablasExperiencia.dominio.entidades.ConvTablasExpReal" />
	</stream>
	
	<!--  cabeceraTablasExp -->
	<stream name="TXP0" format="fixedlength">
		<record name="cabeceraTablaExperiencia" template="cabeceraTablaExperiencia"
			class="es.mapfre.gbt.tablasExperiencia.dominio.entidades.CabeceraTablaExperiencia" />
	</stream>
	
	<!--  tablaExperiencia -->
	<stream name="CTM0" format="fixedlength">
		<record name="tablaExperiencia" template="tablaExperiencia"
			class="es.mapfre.gbt.tablasExperiencia.dominio.entidades.TablaExperiencia" />
	</stream>
	
	<!--  incidencias -->
	<stream name="INC0" format="delimited">
		<record name="incidencias" template="incidencias"
			class="es.mapfre.gbt.tablasExperiencia.dominio.entidades.Incidencias" />
	</stream>
	
	<!--  salida -->
	<stream name="SAL0" format="fixedlength">
		<record name="salida" template="salida"
			class="es.mapfre.gbt.tablasExperiencia.dominio.entidades.Salida" />
	</stream>
	
	
	<stream name="R340T000" format="fixedlength">
		<group name="fichaProceso" class="es.mapfre.gbt.tablasExperiencia.dominio.entidades.FichaProceso" minOccurs="0" maxOccurs="unbounded">
		
			<record name="cabecera" template="fichaProcesoR340T001" minOccurs="1" maxOccurs="1" />	
				 		
			<record name="filtrosAmbito" collection="list" minOccurs="0" maxOccurs="unbounded" 
				class="es.mapfre.gbt.tablasExperiencia.dominio.entidades.FiltroFichaProceso" template="filtroProcesoT2"/>

			<!-- JBMARTA - PYAM0025 - INI -->
<!--			<record name="filtrosAdicionales" collection="list" minOccurs="0" maxOccurs="unbounded" -->
<!--					class="es.mapfre.gbt.tablasExperiencia.dominio.entidades.FiltroFichaProcesoAdicional" template="filtroProcesoT3"/> -->
			<!-- JBMARTA - PYAM0025 - FIN -->
			
			<!-- TODO: Obligar a que siempre esté presente este registro -->
			
			<record name="registroParametros" template="registroT4" minOccurs="0" maxOccurs="1"	class="es.mapfre.gbt.tablasExperiencia.dominio.entidades.RegistroParametros"/>
			
			<!-- <group name="parametrosAdicionales" collection="list" class="es.mapfre.gbt.tablasExperiencia.dominio.parametrizacionGeneral.fichaProceso.ParametroAdicional" template="fichaProcesoR340T004"/> -->
	
		</group>	
	</stream>
	
	<stream name="R340T003" format="fixedlength">
		<record name="fichaProcesoR340T003" template="fichaProcesoR340T003"	
		class="es.mapfre.gbt.tablasExperiencia.dominio.entidades.FichaResultado"/>
	</stream>
	
</beanio>