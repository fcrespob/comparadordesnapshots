  <dependencies>
  		<dependency>
			<groupId>com.oracle.coherence</groupId>
			<artifactId>coherence</artifactId>
			<version>12.1.2-0-0</version>
		</dependency>
		<dependency>
			<groupId>com.oracle.coherence.incubator</groupId>
			<artifactId>coherence-common</artifactId>
			<version>12.1.0</version>
		</dependency>
		<dependency>
			<groupId>com.oracle.coherence.incubator</groupId>
			<artifactId>coherence-processingpattern</artifactId>
			<version>12.1.0</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>3.3.1</version>
		</dependency>
		<dependency>
			<groupId>org.beanio</groupId>
			<artifactId>beanio</artifactId>
			<version>2.0.7</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>1.7.7</version>
		</dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
    	<groupId>es.mapfre.solvencia</groupId>
    	<artifactId>dao</artifactId>
    	<version>11.0.0-RELEASE</version>
    </dependency>
    <dependency>
    	<groupId>es.mapfre.solvencia</groupId>
    	<artifactId>utils</artifactId>
    	<version>11.0.0-RELEASE</version>
    </dependency>
    <dependency>
    	<groupId>es.mapfre.solvencia</groupId>
    	<artifactId>dao-impl</artifactId>
    	<version>11.0.0-RELEASE</version>
    </dependency>
  </dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>2.16</version>
					<configuration>
						<argLine>-Dtangosol.coherence.cacheconfig=coherence-cache-solvencia-config.xml
							-Dtangosol.pof.config=solvencia-pof-config.xml
							-Dtangosol.coherence.localhost=127.0.0.1
							-Dtangosol.coherence.wka=127.0.0.1
							-Dtangosol.coherence.wka.port=8088</argLine>
						<!-- <parallel>classes</parallel> <threadCount>2</threadCount> -->
						<skipTests>true</skipTests>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<source>1.7</source>
						<target>1.7</target>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>  
</project>
