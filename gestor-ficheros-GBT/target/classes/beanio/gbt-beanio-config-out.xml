<?xml version="1.0"?>
<beanio xmlns="http://www.beanio.org/2012/03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.beanio.org/2012/03 http://www.beanio.org/2012/03/mapping.xsd">

	<!-- Imports de las plantillas a emplear en los streams de este fichero -->
 	<import resource="classpath:beanio/beanio-plantillas-GBT.xml" />
	
	<typeHandler name="snHandler"
		class="es.mapfre.solvencia.utils.beanio.handlers.YNTypeHandler">
		<property name="yesLiteral" value="S" />
		<property name="noLiteral" value="N" />
	</typeHandler>
	
	<typeHandler name="dateNullHandler"
		class="es.mapfre.solvencia.utils.beanio.handlers.DateNullTypeHandler" >
		<property name="nullDate" value="00000000" />
		<property name="lastDate" value="99999999" />	
		<property name="lastValiedDate" value="99991231"/>
	</typeHandler>	

	<typeHandler name="bigDecimalAbsOutHandler"
		class="es.mapfre.solvencia.utils.beanio.handlers.BigDecimalAbsOutTypeHandler" />

	<stream name="error-orquestador" format="delimited">
		<record name="errorOrquestador" template="errorOrquestador"
			class="es.mapfre.solvencia.dominio.gbt.ErrorOrquestador" />
	</stream>
</beanio>